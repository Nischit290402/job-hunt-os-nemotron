# Copy to .env.local for scripts, and set the same values in Vercel > Project > Settings > Environment Variables.

# App
APP_URL=https://your-app.vercel.app
# 32+ random characters: openssl rand -hex 32
SIGNING_SECRET=

# Database (Neon: create a project, copy the pooled connection string)
DATABASE_URL=postgres://...

# Telegram (BotFather: /newbot). Chat id: message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 32+ random characters, letters/digits/_/- only
TELEGRAM_WEBHOOK_SECRET=

# Claude work runs in your Claude Code scheduled task (no API key). From claude.ai/code/routines after step 5 of docs/SETUP.md:
ROUTINE_FIRE_URL=
ROUTINE_TOKEN=
WORKER_TOKEN=
JUDGE_MAX_PER_DAY=40

# Inngest (the Vercel integration sets these for you)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Firecrawl (job search only). Caps are hard stops.
FIRECRAWL_API_KEY=
FIRECRAWL_DAILY_CAP=10
FIRECRAWL_MONTHLY_CAP=1240
FIRECRAWL_LIFETIME_CAP=9900

# Contact finding (optional)
BRAVE_SEARCH_API_KEY=
HUNTER_API_KEY=

# Gmail sending (optional; npm run gmail:auth prints the refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=nischitv29@gmail.com

# Laptop agent
# 32+ random characters; same value in agent/.env
AGENT_TOKEN=

# Nebius hackathon branch. All LLM calls go to Nebius Token Factory (NVIDIA Nemotron).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_REASON=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
NEBIUS_MODEL_FALLBACK=nvidia/Nemotron-3_5-Lightning
TAVILY_API_KEY=
DEMO_MODE=1
DEMO_PASSWORD=
LLM_DAILY_USD_CAP=1
LLM_TOTAL_USD_CAP=15
TAVILY_DAILY_CAP=150
CRON_SECRET=
VIDEO_URL=
DEMO_SOURCE_IDS=
FEATURE_SEARCH=1

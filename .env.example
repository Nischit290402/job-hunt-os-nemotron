# Copy to .env.local for scripts, and set the same values in Vercel > Project > Settings > Environment Variables.

# App
APP_URL=https://your-app.vercel.app
SIGNING_SECRET=            # 32+ random characters: openssl rand -hex 32

# Database (Neon: create a project, copy the pooled connection string)
DATABASE_URL=postgres://...

# Telegram (BotFather: /newbot). Chat id: message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=   # 32+ random characters, letters/digits/_/- only

# Claude API
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-haiku-4-5-20251001
WRITER_MODEL=claude-sonnet-5-5
MONTHLY_INPUT_TOKEN_CAP=4000000
JUDGE_BATCH_SIZE=5
JUDGE_MAX_PER_DAY=40

# Inngest (the Vercel integration sets these for you)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Firecrawl (job search only). Caps are hard stops.
FIRECRAWL_API_KEY=
FIRECRAWL_DAILY_CAP=10
FIRECRAWL_MONTHLY_CAP=1240
FIRECRAWL_LIFETIME_CAP=9900

# Contact finding (optional)
BRAVE_SEARCH_API_KEY=
HUNTER_API_KEY=

# Gmail sending (optional; npm run gmail:auth prints the refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=nischitv29@gmail.com

# Resume service (optional; see resume-service/)
RESUME_SERVICE_URL=
RESUME_SERVICE_TOKEN=

# Laptop agent
AGENT_TOKEN=               # 32+ random characters; same value in agent/.env
